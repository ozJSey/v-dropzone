{
  "name": "@ozjsey/v-dropzone",
  "version": "0.1.1",
  "description": "Vue 3 directive owning the full drag-drop / paste / click-to-pick / upload pipeline — fixes phantom-leave, MIME filtering, paste, and progress in one binding",
  "author": "Ozgur Seyidoglu",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozjsey/v-dropzone.git"
  },
  "homepage": "https://github.com/ozjsey/v-dropzone#readme",
  "bugs": {
    "url": "https://github.com/ozjsey/v-dropzone/issues"
  },
  "type": "module",
  "main": "dist/vDropzone.min.js",
  "module": "dist/vDropzone.min.js",
  "types": "dist/vDropzone.d.ts",
  "exports": {
    ".": {
      "import": "./dist/vDropzone.min.js",
      "types": "./dist/vDropzone.d.ts"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup vDropzone.ts --format esm --minify --dts --out-dir dist --clean && mv dist/vDropzone.js dist/vDropzone.min.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vue",
    "vue3",
    "directive",
    "dropzone",
    "drop-zone",
    "file-upload",
    "uploader",
    "drag-drop",
    "file-drop",
    "drag-and-drop",
    "attachment",
    "paste-image",
    "multipart",
    "xhr-upload"
  ],
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "jsdom": "^25.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "vue": "^3.5.0"
  }
}
